NODE_ENV=development
PORT=4000
# Comma-separated approved browser origins. Same-origin Vercel requests do not need CORS.
FRONTEND_ORIGIN=http://localhost:5173

# Set this in Vercel; it is never sent to the browser.
CMC_API_KEY=replace_with_coinmarketcap_api_key
CMC_BASE_URL=https://pro-api.coinmarketcap.com

# Use a managed Postgres database in Vercel (Vercel Postgres, Neon, Supabase, etc.).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/reservepilot?sslmode=require

QUOTE_CACHE_TTL_SECONDS=60
MAX_HOLDINGS_PER_TREASURY=25
MAX_SNAPSHOTS_PER_TREASURY=500
