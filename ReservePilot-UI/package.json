{
  "name": "reservepilot-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=20.19.0 <21 || >=22.12.0" },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:api": "tsx watch server/src/server.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -p server/tsconfig.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "vercel-build": "prisma generate && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@rolldown/binding-darwin-arm64": "^1.2.11",
    "@vitejs/plugin-react": "latest",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "lucide-react": "latest",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "recharts": "latest",
    "typescript": "latest",
    "vite": "latest",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "autoprefixer": "latest",
    "postcss": "latest",
    "prisma": "^6.19.3",
    "supertest": "^7.3.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "vitest": "^4.1.11"
  }
}
